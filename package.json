{
  "name": "otterbots",
  "version": "1.0.0",
  "description": "Un framework pour les bots discord de l'antre des loutres",
  "homepage": "https://github.com/L-Antre-des-Loutres/Otterbots#readme",
  "bugs": {
    "url": "https://github.com/L-Antre-des-Loutres/Otterbots/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-Antre-des-Loutres/Otterbots.git"
  },
  "license": "MIT",
  "author": "Antre des Loutres",
  "type": "commonjs",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "!build/**/*.map",
    "!build/**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "lint": "npx eslint \"src/**/*.ts\"",
    "start": "node ./build/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "example": "npm run build && node ./build/example/index.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "figlet": "^1.9.3",
    "node-cron": "^4.2.1",
    "pino": "^10.1.0"
  },
  "peerDependencies": {
    "discord.js": "^14.23.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^4.1.0",
    "discord.js": "^14.23.2",
    "eslint": "^9.38.0",
    "pino-pretty": "^13.1.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
